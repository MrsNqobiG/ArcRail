{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)"
    ],
    "allow": [
      "WebFetch(domain:docs.arc.io)",
      "WebFetch(domain:developers.circle.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:www.fsca.co.za)",
      "WebFetch(domain:www.fic.gov.za)",
      "WebFetch(domain:www.resbank.co.za)",
      "WebFetch(domain:www.treasury.gov.za)",
      "WebFetch(domain:inforegulator.org.za)",
      "WebFetch(domain:www.gov.za)",
      "WebFetch(domain:docs.dfns.co)",
      "WebFetch(domain:www.circle.com)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "rpc.testnet.arc.io",
        "docs.arc.io",
        "developers.circle.com",
        "registry.npmjs.org",
        "github.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "docs.dfns.co"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
