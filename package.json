{
  "name": "arc-rail-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Arc Rail Adapter beside an existing core banking system. TESTNET ONLY (chain ID 5042002) until every G-M gate in docs/GATES.md is signed.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "mutation": "stryker run",
    "sbom": "cyclonedx-npm --omit dev --package-lock-only --output-format JSON --output-file sbom.cdx.json --validate --output-reproducible",
    "ci": "bash scripts/ci.sh",
    "coverage": "vitest run --coverage",
    "test:contract": "vitest run --project contract",
    "test:e2e": "ARC_E2E=1 vitest run --project e2e",
    "lint:money": "node tools/lint-money-floats.mjs"
  },
  "dependencies": {
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vitest": "4.1.11"
  }
}
